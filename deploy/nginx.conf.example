# Meridian landing page — nginx server block.
#
# Copy to /etc/nginx/sites-available/meridian, edit the two placeholders, link
# it into sites-enabled, then `nginx -t && systemctl reload nginx`.
#
# Placeholders, both of which must be replaced:
#   MERIDIAN_HOST   the subdomain this is served at
#   MERIDIAN_PORT   the host port the container publishes (docker run -p)

# ── HTTP: redirect everything, serve only the ACME challenge ─────────────────
server {
    listen 80;
    listen [::]:80;
    server_name MERIDIAN_HOST;

    # Certbot writes here. It has to stay reachable over plain HTTP or renewal
    # fails silently and the certificate expires ninety days later.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS ────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name MERIDIAN_HOST;

    ssl_certificate     /etc/letsencrypt/live/MERIDIAN_HOST/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/MERIDIAN_HOST/privkey.pem;

    # AC-055. TLS 1.3 only. 1.2 is still widely considered acceptable; this page
    # has no legacy clients to serve and no reason to negotiate down.
    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    # AC-055. Two years, subdomains included. Do not add `preload` until you are
    # certain every subdomain will serve HTTPS forever — the preload list is
    # slow to leave and it applies to the whole domain.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;

    # AC-055. Tight because the page has earned it: no third-party script, no
    # analytics, no ad tag, and next/font self-hosts the faces at build time, so
    # nothing legitimate is loaded cross-origin.
    #
    # 'unsafe-inline' on script-src is Next.js's bootstrap and hydration data.
    # Removing it means switching to a nonce, which needs a dynamic response —
    # and this page is prerendered static HTML on purpose. That trade is the
    # reason the directive is here rather than absent.
    #
    # blob: on worker-src and img-src is three.js: it builds textures and can
    # spin up workers from object URLs.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; media-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # ── AC-056. Client IPs are personal data ────────────────────────────────
    #
    # The default combined format logs the full address. Two lawful options,
    # and you must pick one rather than leaving the default:
    #
    #   1. Log nothing per request (below). Nothing to retain, nothing to leak.
    #   2. Comment this out, keep the default format, and state a retention
    #      period no longer than 30 days in the privacy policy — then actually
    #      enforce it with logrotate.
    #
    # Option 1 is the default here because this page has no abuse surface worth
    # investigating: it serves static HTML and one health endpoint.
    access_log off;
    error_log /var/log/nginx/meridian.error.log warn;

    # ── Proxy ───────────────────────────────────────────────────────────────
    location / {
        proxy_pass http://127.0.0.1:MERIDIAN_PORT;
        proxy_http_version 1.1;

        # AC-042, and the reason AC-023's rate limit is not global. Behind a
        # proxy the socket address is always the proxy, so without this header
        # every visitor shares one bucket and the limit becomes a site-wide
        # cap — a bug that passes locally and only appears in production.
        #
        # The app trusts exactly one hop. Putting a CDN in front of nginx adds
        # a second and this line has to change with it.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # The container's own healthcheck already hits this; exposing it publicly
    # is harmless — it reads nothing and contacts nothing — and it is what an
    # uptime monitor should poll instead of the full page.
    location = /api/health {
        proxy_pass http://127.0.0.1:MERIDIAN_PORT;
        proxy_set_header Host $host;
        access_log off;
    }

    # The pack model and the panel artwork never change without a rebuild, and
    # they are the heaviest thing on the page.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:MERIDIAN_PORT;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
